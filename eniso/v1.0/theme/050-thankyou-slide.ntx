@define thankyou-slide(title:"", author:""){
    page{
        rectangle(background: "#ffffff")

        styles{
            (.title){
                color: "#003366",
                origin: center,
                position: (52, 43),
                font-size: 8%P,
                font-family: "SansSerif",
                font-bold
            }
            (.subtitle){
                color: "#0284c7",
                origin: center,
                position: (52, 55),
                font-size: 4.2%P,
                font-family: "SansSerif",
                font-bold
            }
            (.author){
                color: "#0f172a",
                origin: center,
                position: (52, 70),
                font-size: 3.6%P,
                font-family: "SansSerif",
                font-bold
            }
            (.email){
                color: "#0284c7",
                origin: center,
                position: (52, 77),
                font-size: 3%P,
                font-family: "SansSerif"
            }
        }

        // ── Full-height left navy sidebar (same as cover)
        rectangle(
            position: (0, 0),
            size: (2.5, 100),
            background: "#003366"
        )
        rectangle(
            position: (2.5, 0),
            size: (0.6, 100),
            background: "#0284c7"
        )

        // Header area background
        rectangle(
            position: (3.1, 0),
            size: (96.9, 13),
            background: "#f8fafc"
        )
        rectangle(
            position: (3.1, 13),
            size: (96.9, 0.25),
            background: "#e2e8f0"
        )

        // Institutional header
        text("École Nationale d'Ingénieurs de Sousse · Université de Sousse",
            position: (5, 7),
            origin: left,
            font-size: 2.8%P,
            font-bold,
            color: "#003366"
        )

        // ENISo Logo (fixed)
        image("images/eniso.png", origin: right, position: (97, 6.5), size: (9, 10), preserve-aspect-ratio)

        // Accent dividers in center
        rectangle(
            position: (20, 63),
            size: (60, 0.5),
            background: "#0284c7"
        )
        rectangle(
            position: (36, 65),
            size: (28, 0.2),
            background: "#e2e8f0"
        )

        @(title)    text(either("$title", "Merci pour votre attention"))
        @(subtitle) text("Questions & Discussion")
        @(author)   text(either("$author", either("${documentAuthor}", "")))
        @(email)    text(either("${documentAuthorEmail}", ""))
        body
    }
}
