@define cover-slide(){
    page{
        styles{
            (.institution){
                color: "#003366",
                origin: left,
                position: (4, 7),
                font-size: 3%P,
                font-bold
            }
            (.title){
                color: "#003366",
                origin: center,
                position: (50, 38),
                font-size: 7.5%P,
                font-family: "SansSerif",
                font-bold
            }
            (.subtitle){
                color: "#0284c7",
                origin: center,
                position: (50, 49),
                font-size: 4.8%P,
                font-family: "SansSerif",
                font-bold
            }
            (.subsubtitle){
                color: "#64748b",
                origin: center,
                position: (50, 58),
                font-size: 3.5%P,
                font-family: "SansSerif"
            }
            (.author){
                color: "#0f172a",
                origin: center,
                position: (50, 75),
                font-size: 3.8%P,
                font-bold
            }
            (.email){
                color: "#0284c7",
                origin: center,
                position: (50, 81),
                font-size: 3%P
            }
            (.affiliation){
                color: "#64748b",
                origin: center,
                position: (50, 87),
                font-size: 3%P
            }
            (.date){
                color: "#94a3b8",
                origin: center,
                position: (50, 93),
                font-size: 2.8%P
            }
        }

        // Clean white background
        rectangle(background: "#ffffff")

        // Top institutional navy bar
        rectangle(
            position: (0, 0),
            size: (100, 1.2),
            background: "#003366"
        )

        // Institutional header
        @(institution) text("École Nationale d'Ingénieurs de Sousse · Université de Sousse")

        // ENISo logo top-right
        image("images/eniso.png", origin: right, position: (96, 7), size: (8, 7), preserve-aspect-ratio)

        // Header separator line
        rectangle(
            position: (0, 12),
            size: (100, 0.2),
            background: "#e2e8f0"
        )

        // Middle accent line
        rectangle(
            position: (35, 65),
            size: (30, 0.4),
            background: "#0284c7"
        )

        @(title)       text("${documentTitle}")
        @(subtitle)    text(value: either("${documentSubtitle}", ""))
        @(subsubtitle) text(either("${documentSubsubtitle}", ""))
        @(author)      text(either("${documentAuthor}", ""))
        @(email)       text(either("${documentAuthorEmail}", ""))
        @(affiliation) text(either("${documentAuthorAffiliation}", ""))
        @(date)        text(either("${documentDate}", ""))
        body
    }
}
