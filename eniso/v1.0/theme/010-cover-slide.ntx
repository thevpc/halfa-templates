@define cover-slide(){
    page{
        styles{
            (.institution){
                color: "#003366",
                origin: left,
                position: (5, 7),
                font-size: 2.8%P,
                font-bold
            }
            (.title){
                color: "#003366",
                origin: center,
                position: (52, 42),
                font-size: 7.5%P,
                font-family: "SansSerif",
                font-bold
            }
            (.subtitle){
                color: "#0284c7",
                origin: center,
                position: (52, 53),
                font-size: 4.8%P,
                font-family: "SansSerif",
                font-bold
            }
            (.subsubtitle){
                color: "#64748b",
                origin: center,
                position: (52, 61),
                font-size: 3.5%P,
                font-family: "SansSerif"
            }
            (.author){
                color: "#0f172a",
                origin: center,
                position: (52, 76),
                font-size: 3.8%P,
                font-bold
            }
            (.email){
                color: "#0284c7",
                origin: center,
                position: (52, 82),
                font-size: 3%P
            }
            (.affiliation){
                color: "#64748b",
                origin: center,
                position: (52, 88),
                font-size: 3%P
            }
            (.date){
                color: "#94a3b8",
                origin: center,
                position: (52, 94),
                font-size: 2.8%P
            }
        }

        // Clean white background
        rectangle(background: "#ffffff")

        // ── Full-height left navy sidebar (wider than content slides for emphasis)
        rectangle(
            position: (0, 0),
            size: (2.5, 100),
            background: "#003366"
        )
        // Azure accent stripe
        rectangle(
            position: (2.5, 0),
            size: (0.6, 100),
            background: "#0284c7"
        )

        // Institutional header area background
        rectangle(
            position: (3.1, 0),
            size: (96.9, 13),
            background: "#f8fafc"
        )

        // Institution header bottom rule
        rectangle(
            position: (3.1, 13),
            size: (96.9, 0.25),
            background: "#e2e8f0"
        )

        // Institutional text
        @(institution) text("École Nationale d'Ingénieurs de Sousse · Université de Sousse")

        // ENISo logo top-right (fixed: 80% of the 13% header area)
        image("images/eniso.png", origin: right, position: (97, 6.5), size: (9, 10), preserve-aspect-ratio)

        // Diagonal azure accent line across middle section
        rectangle(
            position: (20, 66),
            size: (60, 0.5),
            background: "#0284c7"
        )
        rectangle(
            position: (36, 68),
            size: (28, 0.2),
            background: "#e2e8f0"
        )

        @(title)       text("${documentTitle}")
        @(subtitle)    text(value: either("${documentSubtitle}", ""))
        @(subsubtitle) text(either("${documentSubsubtitle}", ""))
        @(author)      text(either("${documentAuthor}", ""))
        @(email)       text(either("${documentAuthorEmail}", ""))
        @(affiliation) text(either("${documentAuthorAffiliation}", ""))
        @(date)        text(either("${documentDate}", ""))
        body
    }
}
