@define conclusion-slide(title:""){
    content-slide(title: either("$title", "Conclusion")){
        styles{
            (.title){
                color: "#003366",
                origin: center,
                position: (50, 40),
                font-size: 8%P,
                font-family: "SansSerif",
                font-bold
            }
            (.author){
                color: "#0284c7",
                origin: center,
                position: (50, 56),
                font-size: 4%P,
                font-family: "SansSerif",
                font-bold
            }
        }
        body
    }
}
