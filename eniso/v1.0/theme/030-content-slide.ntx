@define content-slide(title:""){
    page{
        rectangle(background: "#f8fafc")

        // ── Left navy sidebar ─────────────────────────────────────────────
        rectangle(
            position: (0, 0),
            size: (1.2, 100),
            background: "#003366"
        )
        // Azure accent stripe next to sidebar
        rectangle(
            position: (1.2, 0),
            size: (0.4, 100),
            background: "#0284c7"
        )

        // ── Header ────────────────────────────────────────────────────────
        @define header{
            group(
                position: (1.6, 0),
                size: (98.4, 11.5),
                origin: top-left
            ){
                // White header background
                rectangle(background: "#ffffff")

                // Header bottom rule
                rectangle(
                    position: (0, 97),
                    size: (100, 0.5),
                    background: "#e2e8f0"
                )

                // Azure underline beneath the title block
                rectangle(
                    position: (0, 94),
                    size: (28, 3.5),
                    background: "#0284c7"
                )

                // Slide title
                text(
                    "${title}",
                    position: (1.5, 52),
                    origin: left,
                    font-size: 4.8%P,
                    font-bold,
                    color: "#003366"
                )

                // Chapter breadcrumb (right)
                text(
                    either("${documentChapter}", "${documentTitle}"),
                    position: (88, 52),
                    origin: right,
                    font-size: 2.6%P,
                    color: "#64748b"
                )

                // ENISo logo — 80% of header height, right-anchored
                image("images/eniso.png", origin: right, position: (97, 50), size: (8, 80), preserve-aspect-ratio)

                body
            }
        }

        // ── Body area ─────────────────────────────────────────────────────
        @define body{
            group(
                position: (3, 14),
                size: (94, 80),
                origin: top-left,
                font-size: 4.2%P,
                color: "#1e293b"
            ){
                body
            }
        }

        @define body2a{
            group(
                position: (3, 14),
                size: (45, 80),
                origin: top-left,
                font-size: 4.2%P,
                color: "#1e293b"
            ){
                body
            }
        }

        @define body2b{
            group(
                position: (52, 14),
                size: (45, 80),
                origin: top-left,
                font-size: 4.2%P,
                color: "#1e293b"
            ){
                body
            }
        }

        @define body3a{
            group(
                position: (3, 14),
                size: (29, 80),
                origin: top-left,
                font-size: 3.8%P,
                color: "#1e293b"
            ){
                body
            }
        }

        @define body3b{
            group(
                position: (35, 14),
                size: (29, 80),
                origin: top-left,
                font-size: 3.8%P,
                color: "#1e293b"
            ){
                body
            }
        }

        @define body3c{
            group(
                position: (67, 14),
                size: (29, 80),
                origin: top-left,
                font-size: 3.8%P,
                color: "#1e293b"
            ){
                body
            }
        }

        // ── Footer ────────────────────────────────────────────────────────
        rectangle(
            position: (1.6, 96.5),
            size: (98.4, 0.2),
            background: "#e2e8f0"
        )

        // Small azure dot marker in footer
        ellipse(
            position: (2.6, 98.4),
            size: (0.7, 1.2),
            background: "#0284c7"
        )

        // Footer left: document title
        text(
            either("${documentTitle}", "ENISo"),
            position: (3.8, 98.4),
            origin: left,
            font-size: 2%P,
            color: "#94a3b8"
        )

        // Footer right: author
        text(
            either("${documentAuthor}", ""),
            position: (98.4, 98.4),
            origin: right,
            font-size: 2%P,
            color: "#94a3b8"
        )

        header()
        body
    }
}
