@define content-slide(title:""){
    page{
        rectangle(background: "#ffffff")

        // Top thin navy brand accent
        rectangle(
            position: (0, 0),
            size: (100, 0.8),
            background: "#003366"
        )

        @define header{
            group(
                position: (0, 0.8),
                size: (100, 11),
                origin: top-left
            ){
                // Header bottom divider
                rectangle(
                    position: (0, 98),
                    size: (100, 2),
                    background: "#e2e8f0"
                )
                // Azure indicator under title
                rectangle(
                    position: (0, 96),
                    size: (10, 4),
                    background: "#0284c7"
                )

                // Slide Title
                text(
                    "${title}",
                    position: (3, 52),
                    origin: left,
                    font-size: 4.6%P,
                    font-bold,
                    color: "#003366"
                )

                // Chapter breadcrumb (right)
                text(
                    either("${documentChapter}", "${documentTitle}"),
                    position: (89, 52),
                    origin: right,
                    font-size: 2.6%P,
                    color: "#64748b"
                )

                // ENISo Logo (top-right)
                image("images/eniso.png", origin: right, position: (97, 52), size: (6, 6.5), preserve-aspect-ratio)

                body
            }
        }

        @define body{
            group(
                position: (3, 13.5),
                size: (94, 81),
                origin: top-left,
                font-size: 4.2%P,
                color: "#1e293b"
            ){
                body
            }
        }

        @define body2a{
            group(
                position: (3, 13.5),
                size: (45, 81),
                origin: top-left,
                font-size: 4.2%P,
                color: "#1e293b"
            ){
                body
            }
        }

        @define body2b{
            group(
                position: (52, 13.5),
                size: (45, 81),
                origin: top-left,
                font-size: 4.2%P,
                color: "#1e293b"
            ){
                body
            }
        }

        @define body3a{
            group(
                position: (3, 13.5),
                size: (29, 81),
                origin: top-left,
                font-size: 3.8%P,
                color: "#1e293b"
            ){
                body
            }
        }

        @define body3b{
            group(
                position: (35, 13.5),
                size: (29, 81),
                origin: top-left,
                font-size: 3.8%P,
                color: "#1e293b"
            ){
                body
            }
        }

        @define body3c{
            group(
                position: (67, 13.5),
                size: (29, 81),
                origin: top-left,
                font-size: 3.8%P,
                color: "#1e293b"
            ){
                body
            }
        }

        // Footer separator
        rectangle(
            position: (0, 96),
            size: (100, 0.2),
            background: "#e2e8f0"
        )

        // Footer left: Institution & Title
        text(
            either("${documentTitle}", "ENISo"),
            position: (3, 98),
            origin: left,
            font-size: 2%P,
            color: "#94a3b8"
        )

        // Footer right: Author
        text(
            either("${documentAuthor}", ""),
            position: (97, 98),
            origin: right,
            font-size: 2%P,
            color: "#94a3b8"
        )

        header()
        body
    }
}
