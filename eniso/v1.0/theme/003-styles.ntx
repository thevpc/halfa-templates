styles{
    (*){
        font-size: 4.5%P
        font-family: "SansSerif",
        color: "#1e293b"
    }

    source{
        font-size: 3.2%P,
        font-family: "monospaced",
        source-primary-color: "#f8fafc"
        source-keyword-color: "#38bdf8"
        source-separator-color: "#94a3b8"
        source-string-color: "#4ade80"
        source-comments-color: "#94a3b8"
        source-number-color: "#fbbf24"
        source-keyword-font-bold
        background: "#0a192f"
        color: "#f8fafc"
        draw-contour: true
        padding: (1%P, 0.5%P)
    }

    page{
        background: "#ffffff"
    }

    (.ul-item){
        margin: (4, 0)
        at: left,
    }
    (.ul-bullet){
        background: documentColors[1]
        at: left,
        size: 2%P,
        bullet-align: top
    }
    (.ol-bullet){
        color: documentColors[0]
        at: center,
        font-bold
    }
    (.ol-item){
        at: left,
        margin: (3, 0)
    }
    ellipse{
        at: center,
    }
    arc{
        at: center,
    }

    (.image-fig){
        margin: 2
    }
    (.image-fig-legend){
        at: bottom
        font-size: 1.5%P
        color: "#64748b"
        margin: (1, 1, 1, 2)
    }
    (.image-fig-title){
        at: top
        font-size: 3.5%P
        font-bold,
        color: documentColors[0]
    }
}
