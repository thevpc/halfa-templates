@define thankyou-slide(title:""){
    page{
        rectangle(background: documentBg)

        styles{
            (.kicker){
                color: documentColors[0],
                origin: left,
                position: (8, 26),
                font-size: 2.8%P,
                font-family: "SansSerif",
                font-bold
            }
            (.thankyou-title){
                color: documentTextPrimary,
                origin: left,
                position: (8, 40),
                font-size: 8.5%P,
                font-family: "SansSerif",
                font-bold
            }
            (.thankyou-subtitle){
                color: documentColors[0],
                origin: left,
                position: (8, 52),
                font-size: 4%P,
                font-family: "SansSerif",
                font-bold
            }
            (.thankyou-author){
                color: documentTextPrimary,
                origin: left,
                position: (8, 74),
                font-size: 3.4%P,
                font-family: "SansSerif",
                font-bold
            }
            (.thankyou-email){
                color: documentColors[0],
                origin: left,
                position: (8, 78.5),
                font-size: 2.8%P,
                font-family: "SansSerif"
            }
        }

        // Editorial corner marks, mirrored from the cover
        rectangle(position: (6, 6), size: (5, 0.2), background: documentColors[0])
        rectangle(position: (6, 6), size: (0.2, 5), background: documentColors[0])
        rectangle(position: (89, 94), size: (5, 0.2), background: documentColors[0])
        rectangle(position: (94, 89), size: (0.2, 5), background: documentColors[0])

        // Accent rule
        rectangle(position: (8, 60), size: (12, 0.3), background: documentColors[0])

        @(kicker)            text("Thank You")
        @(thankyou-title)    text(either("${title}", "Questions?"))
        @(thankyou-subtitle) text("Let's discuss")
        @(thankyou-author)   text(either("${documentAuthor}", ""))
        @(thankyou-email)    text(either("${documentAuthorEmail}", ""))
        body
    }
}
