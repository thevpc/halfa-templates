@define content-slide(title){
    page{
        rectangle(background: "#ffffff")

        @define header{
            group(
                position: (0, 0),
                size: (100, 11),
                origin: top-left
            ){
                // Header accent bar
                rectangle(
                    position: (0, 98),
                    size: (100, 2),
                    background: "#e2e8f0"
                )
                rectangle(
                    position: (0, 96),
                    size: (12, 4),
                    background: documentColors[1]
                )

                // Slide Title
                text(
                    "${title}",
                    position: (3, 55),
                    origin: left,
                    font-size: 4.8%P,
                    font-bold,
                    color: "#0f172a"
                )

                // Chapter breadcrumb (right)
                text(
                    either("${documentChapter}", "${documentTitle}"),
                    position: (97, 55),
                    origin: right,
                    font-size: 2.8%P,
                    color: "#64748b"
                )

                body
            }
        }

        @define body{
            group(
                position: (3, 14),
                size: (94, 82),
                origin: top-left,
                font-size: 3.4%P,
                color: "#1e293b"
            ){
                body
            }
        }

        @define body2a{
            col(
                position: (3, 14),
                size: (45, 82),
                origin: top-left,
                font-size: 2.8%P,
                color: "#1e293b"
            ){
                styles{
                    (.ul-item){
                        font-size: 2.6%P
                        margin: (1.4, 0)
                        text-wrap: wrap
                    }
                    (.ol-item){
                        font-size: 2.6%P
                        margin: (1.4, 0)
                        text-wrap: wrap
                    }
                    (.ul-bullet){
                        size: 1.4%P
                    }
                }
                body
            }
        }

        @define body2b{
            col(
                position: (52, 14),
                size: (45, 82),
                origin: top-left,
                font-size: 2.8%P,
                color: "#1e293b"
            ){
                styles{
                    (.ul-item){
                        font-size: 2.6%P
                        margin: (1.4, 0)
                        text-wrap: wrap
                    }
                    (.ol-item){
                        font-size: 2.6%P
                        margin: (1.4, 0)
                        text-wrap: wrap
                    }
                    (.ul-bullet){
                        size: 1.4%P
                    }
                }
                body
            }
        }

        @define body3a{
            col(
                position: (3, 14),
                size: (29, 82),
                origin: top-left,
                font-size: 2.4%P,
                color: "#1e293b"
            ){
                styles{
                    (.ul-item){
                        font-size: 2.2%P
                        margin: (1.2, 0)
                        text-wrap: wrap
                    }
                    (.ol-item){
                        font-size: 2.2%P
                        margin: (1.2, 0)
                        text-wrap: wrap
                    }
                    (.ul-bullet){
                        size: 1.2%P
                    }
                }
                body
            }
        }

        @define body3b{
            col(
                position: (35, 14),
                size: (29, 82),
                origin: top-left,
                font-size: 2.4%P,
                color: "#1e293b"
            ){
                styles{
                    (.ul-item){
                        font-size: 2.2%P
                        margin: (1.2, 0)
                        text-wrap: wrap
                    }
                    (.ol-item){
                        font-size: 2.2%P
                        margin: (1.2, 0)
                        text-wrap: wrap
                    }
                    (.ul-bullet){
                        size: 1.2%P
                    }
                }
                body
            }
        }

        @define body3c{
            col(
                position: (67, 14),
                size: (29, 82),
                origin: top-left,
                font-size: 2.4%P,
                color: "#1e293b"
            ){
                styles{
                    (.ul-item){
                        font-size: 2.2%P
                        margin: (1.2, 0)
                        text-wrap: wrap
                    }
                    (.ol-item){
                        font-size: 2.2%P
                        margin: (1.2, 0)
                        text-wrap: wrap
                    }
                    (.ul-bullet){
                        size: 1.2%P
                    }
                }
                body
            }
        }

        header()
        body
    }
}
