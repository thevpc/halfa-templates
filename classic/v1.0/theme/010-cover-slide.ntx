@define cover-slide(){
    page{
        styles{
            (.title){
                color: "#0f172a",
                origin: center,
                position: (50, 32),
                font-size: 8%P,
                font-family: "SansSerif",
                font-bold
            }
            (.subtitle){
                color: documentColors[1],
                origin: center,
                position: (50, 44),
                font-size: 4.5%P,
                font-family: "SansSerif",
                font-bold
            }
            (.subsubtitle){
                color: "#64748b",
                origin: center,
                position: (50, 53),
                font-size: 3.5%P,
                font-family: "SansSerif"
            }
            (.author){
                color: "#0f172a",
                origin: center,
                position: (50, 72),
                font-size: 3.8%P,
                font-bold
            }
            (.affiliation){
                color: "#475569",
                origin: center,
                position: (50, 78),
                font-size: 3.2%P
            }
            (.email){
                color: documentColors[1],
                origin: center,
                position: (50, 84),
                font-size: 3%P
            }
            (.date){
                color: "#94a3b8",
                origin: center,
                position: (50, 92),
                font-size: 2.8%P
            }
        }

        // Clean white background
        rectangle(background: "#ffffff")

        // Top accent line
        rectangle(
            position: (0, 0),
            size: (100, 1.2),
            background: documentColors[1]
        )

        // Middle accent divider
        rectangle(
            position: (35, 62),
            size: (30, 0.4),
            background: documentColors[1]
        )

        @(title)       text("${documentTitle}")
        @(subtitle)    text(value: either("${documentSubtitle}", ""))
        @(subsubtitle) text(either("${documentSubsubtitle}", ""))
        @(author)      text(either("${documentAuthor}", ""))
        @(affiliation) text(either("${documentAuthorAffiliation}", ""))
        @(email)       text(either("${documentAuthorEmail}", ""))
        @(date)        text(either("${documentDate}", ""))
        body
    }
}
